{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KOEDU Program",
  "type": "object",
  "required": ["title", "description", "university", "level", "semester"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "university": { "type": "string", "minLength": 1 },
    "campus": { "type": "string" },
    "level": { "type": "string", "enum": ["Bachelor", "Master", "PhD", "Language"] },
    "semester": {
      "type": "string",
      "pattern": "^[0-9]{4}-(Spring|Fall|Summer|Winter)$"
    },
    "delivery": { "type": "string", "enum": ["Online", "On-campus", "Hybrid"] },
    "language": { "type": "string" },
    "duration": { "type": "string" },
    "ectsOrCredits": { "type": "number" },

    "fees": { "type": ["number", "null"] },
    "feesBreakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "amount"],
        "properties": {
          "label": { "type": "string" },
          "amount": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "currency": { "type": "string", "default": "KRW" },

    "admissions": {
      "type": "object",
      "properties": {
        "applicationWindow": {
          "type": "object",
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" }
          },
          "additionalProperties": false
        },
        "deadlines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "date"],
            "properties": {
              "label": { "type": "string" },
              "date": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "requirements": {
          "type": "object",
          "properties": {
            "education": { "type": "string" },
            "gpaMin": { "type": "number" },
            "tests": { "type": "array", "items": { "type": "string" } },
            "documents": { "type": "array", "items": { "type": "string" } },
            "portfolio": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "selection": { "type": "string" },
        "applicationLink": { "type": "string" }
      },
      "additionalProperties": true
    },

    "contacts": {
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "website": { "type": "string" }
      },
      "additionalProperties": false
    },

    "media": {
      "type": "object",
      "properties": {
        "coverImage": { "type": "string" },
        "gallery": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "tags": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "searchIndex": { "type": "array", "items": { "type": "string" } },

    "status": { "type": "string", "enum": ["draft", "published", "archived"], "default": "published" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "additionalProperties": true
}
